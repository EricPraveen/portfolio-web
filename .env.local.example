# Environment Variables — Contact Form
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# For production (Vercel, Netlify, etc.) set these in your
# hosting dashboard, not in this file.

# ── Required ─────────────────────────────────────────────
# The email address that receives contact form submissions.
CONTACT_EMAIL_TO=your@email.com

# ── SMTP Credentials (only needed in production) ─────────
# Examples: smtp.gmail.com (587), smtp.fastmail.com (465)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# ── Notes ────────────────────────────────────────────────
# In development (NODE_ENV=development) no email is sent;
# form submissions are printed to the terminal instead.
